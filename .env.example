APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_SECURE_COOKIE=true (also defaults on when APP_ENV=production)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local demo accounts only (php artisan db:seed --class=DemoSeeder). Never set in production.
DEMO_PASSWORD=

# Admin MFA (section 53). Local/testing: off. Production: on by default when APP_ENV=production.
BEACON_ADMIN_MFA=false
# Days after account creation (or BEACON_ADMIN_MFA_ENFORCED_FROM) before enrollment is mandatory.
# Empty/null = never forced. 0 = immediate. Production default is 7 when unset.
# BEACON_ADMIN_MFA_ENFORCE_AFTER_DAYS=7
# BEACON_ADMIN_MFA_ENFORCED_FROM=2026-11-01

# Production transport (section 53). Defaults on when APP_ENV=production.
BEACON_FORCE_HTTPS=false
# APP_DEBUG=false
# APP_URL=https://your-domain.example

# AI provider: null (disabled) | fake (tests) | openai | openrouter
AI_DRIVER=null

# --- Low-cost OpenAI (recommended for voice structuring + receipt vision) ---
# Voice path: browser Web Speech (free) -> gpt-6-luna structures the Arabic text.
# Do NOT send audio to OpenAI for the normal UI path.
# OPENAI_API_KEY=sk-...
# AI_DRIVER=openai
# AI_OCR_DRIVER=ai
# AI_VOICE_ENABLED=true
# AI_STT_DRIVER=whisper
# OPENAI_CHAT_MODEL=gpt-6-luna
# OPENAI_VISION_MODEL=gpt-6-luna
# OPENAI_VISION_DETAIL=low
# OPENAI_VISION_MAX_EDGE=1280
# OPENAI_VISION_JPEG_QUALITY=72
# OPENAI_MAX_TOKENS_CHAT=400
# OPENAI_MAX_TOKENS_VISION=220
# OPENAI_TIMEOUT=60
# AI_ASSISTANT_RATE=8
# AI_OCR_RATE=6
# AI_VOICE_RATE=6

# --- OpenRouter (optional free-tier models) ---
OPENROUTER_API_KEY=
# Defaults are free (:free) models. Whisper /audio/transcriptions is paid — use TRANSCRIPTION_MODE=chat.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_TRANSCRIPTION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# OPENROUTER_TRANSCRIPTION_MODE=chat
# OPENROUTER_TIMEOUT=90
# OPENROUTER_HTTP_REFERER="${APP_URL}"
# OPENROUTER_APP_TITLE=Beacon

# Voice draft: browser speech -> ChatGPT structures fields -> user confirms save.
# AI_VOICE_ENABLED=true

# Data-control approvals for outbound AI (required before OpenAI/OpenRouter is called). Keep false until Beacon DPA is signed.
# Local/dev example (browser voice + receipt OCR; no audio STT DPA needed):
#   AI_DRIVER=openai
#   OPENAI_API_KEY=sk-...
#   AI_OCR_DRIVER=ai
#   AI_VOICE_ENABLED=true
#   BEACON_DPA_AI_APPROVED=true
#   BEACON_DPA_AI_ALLOWED_DATA=transaction_type,transaction_description,counterparty,user_question,approved_knowledge
#   BEACON_DPA_OCR_APPROVED=true
#   BEACON_DPA_OCR_ALLOWED_DATA=receipt_image
#   BEACON_DPA_INSIGHTS_APPROVED=true
#   BEACON_DPA_INSIGHTS_ALLOWED_DATA=aggregate_financial_figures
BEACON_DPA_AI_APPROVED=false
BEACON_DPA_AI_ALLOWED_DATA=
BEACON_DPA_OCR_APPROVED=false
BEACON_DPA_OCR_ALLOWED_DATA=
BEACON_DPA_INSIGHTS_APPROVED=false
BEACON_DPA_INSIGHTS_ALLOWED_DATA=
BEACON_DPA_STT_APPROVED=false
BEACON_DPA_STT_ALLOWED_DATA=

# Local voice speech-to-text (whisper.cpp; audio never leaves the server). Language is always Arabic (-l ar).
WHISPER_PATH=whisper-cli
# Model: a .bin path or a short name (small | medium | large-v3-turbo) -> storage/app/whisper/ggml-<name>.bin.
# Empty = large-v3-turbo. Download: https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin (~1.6 GB)
WHISPER_MODEL=
# Optional initial prompt (vocabulary bias). Empty = no --prompt (see docs/whisper-dialect-benchmark.md).
WHISPER_PROMPT=
WHISPER_THREADS=0
WHISPER_TIMEOUT=120
WHISPER_CORRECT=true

# Local receipt OCR (Tesseract). Languages are always ara+eng.
# AI_OCR_DRIVER=tesseract   # tesseract | ai | manual; unset = tesseract in local, manual elsewhere
TESSERACT_PATH=tesseract
# Optional folder containing ara/eng(/osd).traineddata, e.g. C:\Tesseract-OCR\tessdata. Empty = --tessdata-dir not passed.
TESSERACT_TESSDATA_DIR=
# Invoice line items: per-line OCR pass and ruled-table (البيان | الكمية | السعر | القيمة) reader. Both on by default.
# AI_OCR_LINE_PASS=true
# AI_OCR_TABLE_PASS=true

# Review form: warn (never block) when an OCR/voice suggested date is in the future or older than this many days.
AI_REVIEW_OLD_DATE_DAYS=365
